# ATMPL configuration. Every value below is optional: with none of them set, the
# repository runs the keyless offline demo on SQLite with the deterministic mock adapter.
# Copy to `.env` and edit, or export the variables. Never commit a filled-in .env.

# --- persistence -------------------------------------------------------------
# Any SQLAlchemy URL. PostgreSQL needs the `postgres` extra: pip install -e ".[postgres]"
ATMPL_DATABASE_URL=sqlite:///var/atmpl.db
# ATMPL_DATABASE_URL=postgresql+psycopg://atmpl:atmpl@db:5432/atmpl
# Create tables in-process. Defaults to true for SQLite, false elsewhere (run `atmpl db upgrade`).
# ATMPL_AUTO_CREATE_SCHEMA=false

# --- model access ------------------------------------------------------------
# The primary provider. `mock` is deterministic, offline and keyless; `gemini`,
# `anthropic` and `openai` each need their own key in the environment (GEMINI_API_KEY,
# ANTHROPIC_API_KEY, OPENAI_API_KEY). A caller can never choose one of these (G7).
ATMPL_ADAPTER=mock
# Tried in order when the primary fails or its circuit breaker is open. Comma separated.
ATMPL_PROVIDER_FALLBACKS=
ATMPL_PROVIDER_TIMEOUT_SECONDS=30
ATMPL_PROVIDER_MAX_ATTEMPTS=3
ATMPL_PROVIDER_BACKOFF_SECONDS=0.5
# Consecutive failures before a provider is skipped, and for how long.
ATMPL_PROVIDER_BREAKER_THRESHOLD=3
ATMPL_PROVIDER_BREAKER_COOLDOWN_SECONDS=30
# Model and endpoint per provider. Costs are estimated from src/atmpl/providers/prices.yaml;
# a model missing from that table is reported as "not priced", never as zero.
ATMPL_GEMINI_MODEL=gemini-3.6-flash
ATMPL_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ATMPL_ANTHROPIC_MODEL=claude-sonnet-5
ATMPL_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# The OpenAI-compatible adapter also fits Azure, OpenRouter, Together, vLLM and Ollama.
ATMPL_OPENAI_MODEL=gpt-4o-mini
ATMPL_OPENAI_BASE_URL=https://api.openai.com/v1

# --- observability -----------------------------------------------------------
# `none` keeps spans in this process (the /llmops page still works, nothing leaves the
# container); `console` prints them; `otlp` ships them to ATMPL_OTLP_ENDPOINT.
ATMPL_TRACE_EXPORTER=none
ATMPL_OTLP_ENDPOINT=http://localhost:4318/v1/traces
ATMPL_SERVICE_NAME=atmpl
# How many finished spans and model calls /llmops keeps in memory.
ATMPL_TELEMETRY_BUFFER_SIZE=2000
ATMPL_METRICS_ENABLED=1
# Serve /metrics without a credential. Set to 0 to require the `metrics:read` scope.
ATMPL_METRICS_PUBLIC=1
# One JSON object per log line, carrying trace_id and span_id.
ATMPL_JSON_LOGS=0

# --- secrets -----------------------------------------------------------------
# `env` reads ATMPL_SECRET_<NAME>; `file` reads a JSON object at ATMPL_SECRETS_FILE (mode 0600).
ATMPL_SECRETS_BACKEND=env
# ATMPL_SECRETS_FILE=/run/secrets/atmpl.json
# Without these, tokens and sessions are signed with a process-lifetime random key and
# stop working when the process restarts. `atmpl doctor` says so out loud.
# ATMPL_SECRET_JWT_SIGNING_KEY=<64 hex chars>
# ATMPL_SECRET_SESSION_SIGNING_KEY=<64 hex chars>
# Per-source inbound webhook secrets override whatever the org profile stores:
# ATMPL_SECRET_WEBHOOK_INBOUND_HELPDESK=whsec_...

# --- identity ----------------------------------------------------------------
# Set BOTH to require a dashboard login. With neither, the dashboard runs in demo mode
# and decisions are recorded as `human:demo`. Generate the hash: atmpl users hash-password
# ATMPL_ADMIN_USER=you
# ATMPL_ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$...
ATMPL_SESSION_TTL_SECONDS=43200
ATMPL_TOKEN_TTL_SECONDS=900
ATMPL_JWT_KEY_ID=atmpl-hs256-1

# --- demo boundary -----------------------------------------------------------
# `atmpl demo up` sets this so the keyless walkthrough can call /api/v1 without a credential.
# Leave it off anywhere real.
ATMPL_DEMO_OPEN_API=0
# Set by the public Hugging Face Space: every page renders, every mutation is refused, and
# no model key can be spent from the demo.
ATMPL_DEMO_READONLY=0

# --- HTTP hardening ----------------------------------------------------------
ATMPL_ALLOWED_ORIGINS=
ATMPL_RATE_LIMIT=120/minute
ATMPL_MAX_BODY_BYTES=1048576
ATMPL_HSTS_ENABLED=0
# Extra script origins allowed by the dashboard CSP (htmx is loaded from unpkg).
ATMPL_CSP_SCRIPT_SRC=https://unpkg.com

# --- webhooks ----------------------------------------------------------------
# Run the outbound delivery worker inside the API process. Otherwise: atmpl webhooks deliver
ATMPL_WEBHOOK_WORKER=0
ATMPL_WEBHOOK_WORKER_INTERVAL_SECONDS=2
ATMPL_WEBHOOK_MAX_ATTEMPTS=5
ATMPL_WEBHOOK_TIMEOUT_SECONDS=10
ATMPL_WEBHOOK_TOLERANCE_SECONDS=300
ATMPL_PUBLIC_BASE_URL=http://127.0.0.1:8000
